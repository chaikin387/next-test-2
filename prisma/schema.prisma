generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ЭНУМЕРАТОРЫ ---
enum Role {
  ADMIN
  USER
}

enum AttributeType {
  SELECT
  COLOR
  TEXT
}

// --- ПОЛЬЗОВАТЕЛИ ---
model User {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  password  String?  @db.VarChar(255)
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart?

  @@map("users")
}

// --- КАТЕГОРИИ ---
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   Product[]
  attributes CategoryAttribute[]

  @@index([isActive, position])
  @@map("categories")
}

// --- ГЛОБАЛЬНЫЕ АТРИБУТЫ (Словарь) ---
model Attribute {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(100)
  slug      String        @unique @db.VarChar(100)
  type      AttributeType @default(SELECT)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  categories CategoryAttribute[]

  @@map("attributes")
}

// --- СВЯЗЬ КАТЕГОРИЯ <-> АТРИБУТ ---
model CategoryAttribute {
  id          Int     @id @default(autoincrement())
  categoryId  Int
  attributeId Int
  isRequired  Boolean @default(false)
  position    Int     @default(0)

  category  Category                 @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute                @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  values    CategoryAttributeValue[]

  @@unique([categoryId, attributeId])
  @@index([categoryId, position])
  @@map("category_attributes")
}

// --- ЗНАЧЕНИЯ АТРИБУТОВ ---
model CategoryAttributeValue {
  id                  Int     @id @default(autoincrement())
  categoryAttributeId Int
  value               String  @db.VarChar(100)
  slug                String  @db.VarChar(100)
  position            Int     @default(0)
  isActive            Boolean @default(true)

  categoryAttribute CategoryAttribute       @relation(fields: [categoryAttributeId], references: [id], onDelete: Cascade)
  variants          VariantAttributeValue[]

  @@unique([categoryAttributeId, slug])
  @@index([categoryAttributeId, isActive, position])
  @@map("category_attribute_values")
}

// --- ТОВАРЫ ---
model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.Text
  imageUrl    String?  @db.VarChar(500)
  categoryId  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([categoryId, isActive])
  @@map("products")
}

// --- ВАРИАНТЫ ТОВАРОВ (SKU) ---
model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  sku       String   @unique @db.VarChar(100)
  name      String   @db.VarChar(255)
  slug      String   @db.VarChar(255)
  price     Int      @default(0)
  oldPrice  Int?
  weight    Int      @default(0)
  stock     Int      @default(0)
  position  Int      @default(0)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  images     VariantImage[]
  attributes VariantAttributeValue[]
  cartItems  CartItem[]

  @@unique([productId, slug])
  @@index([productId, isActive, position])
  @@index([slug])
  @@map("product_variants")
}

// --- СВЯЗЬ ВАРИАНТ <-> ЗНАЧЕНИЕ АТРИБУТА ---
model VariantAttributeValue {
  id               Int @id @default(autoincrement())
  variantId        Int
  attributeValueId Int

  variant        ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue CategoryAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@map("variant_attribute_values")
}

// --- ИЗОБРАЖЕНИЯ ВАРИАНТОВ ---
model VariantImage {
  id        Int     @id @default(autoincrement())
  variantId Int
  url       String  @db.VarChar(500)
  alt       String? @db.VarChar(255)
  position  Int     @default(0)
  isActive  Boolean @default(true)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, isActive, position])
  @@map("variant_images")
}

// --- КОРЗИНА ---
model Cart {
  id        Int       @id @default(autoincrement())
  userId    Int?      @unique
  guestId   String?   @unique @db.VarChar(255)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([guestId, expiresAt])
  @@map("carts")
}

// --- ЭЛЕМЕНТЫ КОРЗИНЫ ---
model CartItem {
  id         Int      @id @default(autoincrement())
  cartId     Int
  variantId  Int
  quantity   Int      @default(1)
  isSelected Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}
